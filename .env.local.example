# ============================================================
# EMPLEOON — Variables de entorno
# Copiar como .env.local y completar con tus valores
# ============================================================

# Supabase — encontrás estos en Settings > API en tu proyecto
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# URL del sitio (en producción, tu dominio)
NEXT_PUBLIC_SITE_URL=https://empleoon.com

# Admin password básico (opcional, para proteger /admin con middleware)
ADMIN_PASSWORD=cambia-esto-por-una-password-segura
